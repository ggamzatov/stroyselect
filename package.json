{
  "name": "stroyselect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrations:check": "node scripts/check-migrations.mjs",
    "migrations:apply": "node scripts/apply-migrations.mjs",
    "legacy:audit": "node scripts/audit-legacy-dependencies.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "authorization:audit": "node scripts/authorization-audit.mjs",
    "production:audit": "node scripts/production-readiness-audit.mjs",
    "production:env:check": "node --env-file=.env.local scripts/production-readiness-audit.mjs --env",
    "verify": "npm run migrations:check && npm run legacy:audit && npm run security:audit && npm run authorization:audit && npm run production:audit && npm run lint && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "storage:audit": "node --env-file=.env.local scripts/audit-storage.mjs",
    "maintenance": "node --env-file=.env.local scripts/maintenance.mjs",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:restore-drill": "bash scripts/db-restore-drill.sh",
    "e2e:seed": "node --env-file=.env.local scripts/seed-e2e.mjs && node --env-file=.env.local scripts/seed-e2e-ops.mjs",
    "test:e2e": "playwright test",
    "test:e2e:marketplace": "playwright test tests/e2e/marketplace-flow.spec.ts",
    "test:e2e:marketplace:seeded": "npm run build && npm run e2e:seed && node --env-file=.env.e2e.local ./node_modules/@playwright/test/cli.js test tests/e2e/marketplace-flow.spec.ts",
    "test:e2e:production:seeded": "npm run build && npm run e2e:seed && node --env-file=.env.e2e.local ./node_modules/@playwright/test/cli.js test tests/e2e/marketplace-flow.spec.ts tests/e2e/production-hardening.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.5.7",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.29.0",
    "next": "16.2.12",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^4.1.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
