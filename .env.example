# Core application
NODE_ENV=production
APP_BASE_URL=https://stroyselect.example.com
NEXT_PUBLIC_APP_URL=https://stroyselect.example.com
CRON_SECRET=change-me-long-random-secret

# PostgreSQL
DATABASE_URL=postgresql://stroyselect:change-me@postgres:5432/stroyselect

# S3-compatible object storage
S3_ENDPOINT=https://s3.example.com
S3_REGION=ru-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=false

# Transactional email (Resend)
RESEND_API_KEY=re_change_me
EMAIL_FROM=StroySelect <no-reply@stroyselect.example.com>

# YooKassa. Keep PAYMENTS_ENABLED=false until the marketplace/safe-deal model is approved for your contractor types.
PAYMENTS_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_PLATFORM_FEE_PERCENT=0

# Yandex Delivery for paid material-order logistics. Leave empty until the corporate API token is issued.
YANDEX_DELIVERY_TOKEN=

# Legal operator details used by public legal documents.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_OGRN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
LEGAL_OPERATOR_PHONE=

# Deployment notes:
# - Never commit real credentials.
# - APP_BASE_URL must be the canonical HTTPS origin used in verification/reset links.
# - CRON_SECRET protects /api/internal/maintenance. Vercel Cron sends it as Bearer authorization.
# - Production must use a private PostgreSQL endpoint and TLS where required by the provider.
# - Buckets expected by the application: contractor-portfolio, project-files, chat-files.
# - Before PAYMENTS_ENABLED=true, configure the YooKassa webhook URL: /api/payments/yookassa/webhook.
# - Before enabling Yandex Delivery, configure YANDEX_DELIVERY_TOKEN and active supplier pickup locations with exact coordinates.
# - Before a public launch, fill all LEGAL_OPERATOR_* fields and complete the release checklist in admin.
