# Core application
NODE_ENV=production
APP_BASE_URL=https://stroyselect.example.com
NEXT_PUBLIC_APP_URL=https://stroyselect.example.com

# PostgreSQL
DATABASE_URL=postgresql://stroyselect:change-me@postgres:5432/stroyselect

# S3-compatible object storage
S3_ENDPOINT=https://s3.example.com
S3_REGION=ru-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=false

# Transactional email (Resend)
RESEND_API_KEY=re_change_me
EMAIL_FROM=StroySelect <no-reply@stroyselect.example.com>

# Deployment notes:
# - Never commit real credentials.
# - APP_BASE_URL must be the canonical HTTPS origin used in verification/reset links.
# - Production must use a private PostgreSQL endpoint and TLS where required by the provider.
# - Buckets expected by the application: contractor-portfolio, project-files, chat-files.
